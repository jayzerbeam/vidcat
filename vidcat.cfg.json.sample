{
	"metadata_key_comment": "The json key used when saving metadata. Recommend NOT changing.",
	"metadata_key": "video_metadata",
	"thumb_height_comment": "The default pixel height for thumbnails.",
	"thumb_height": 200,
	"thumb_interval_comment": "Default interval for thumbnails. Positive is seconds, negative is fixed number.",
	"thumb_interval": -30,
